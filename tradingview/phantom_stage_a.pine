//@version=6
strategy("Phantom Flow Stage A — ATR Shift + MA Oscillator", overlay=true,
     initial_capital=10000, currency=currency.USD,
     pyramiding=0, process_orders_on_close=false,
     commission_type=strategy.commission.cash_per_order, commission_value=0,
     slippage=2)

// Stage A is a transparent baseline approximation, not proprietary Phantom Flow source.
// Intended chart: EURUSD M5. Signals confirm at bar close; market entries fill next bar.
// Python parity defaults: ATR 10 / factor 3 / EMA 15 / SMA 40 / smoothing 3 / threshold 0.5.

atrLen   = input.int(10, "ATR length", minval=1)
factor   = input.float(3.0, "ATR shift factor", minval=0.1, step=0.1)
emaLen   = input.int(15, "Oscillator EMA", minval=1)
baseLen  = input.int(40, "Oscillator baseline SMA", minval=2)
smooth   = input.int(3, "Oscillator smoothing", minval=1)
threshold= input.float(0.5, "Oscillator threshold", minval=0.0, step=0.1)
stopATR  = input.float(1.5, "Stop distance (ATR)", minval=0.1, step=0.1)
rr       = input.float(2.0, "Reward / risk", minval=0.1, step=0.1)
useDate  = input.bool(true, "Use backtest date window")
startDate= input.time(timestamp("01 Jan 2021 00:00 +0000"), "Start (UTC)")
endDate  = input.time(timestamp("31 Dec 2026 23:59 +0000"), "End (UTC)")

[st, direction] = ta.supertrend(factor, atrLen)
atr = ta.atr(atrLen)
oscRaw = (ta.ema(close, emaLen) - ta.sma(close, baseLen)) / math.max(atr, syminfo.mintick)
osc = ta.ema(oscRaw, smooth)

bullShift = direction < 0 and direction[1] > 0
bearShift = direction > 0 and direction[1] < 0
bullCross = ta.crossover(osc, threshold)
bearCross = ta.crossunder(osc, -threshold)
longSignal = bullShift and bullCross
shortSignal = bearShift and bearCross

inDate = not useDate or (time >= startDate and time <= endDate)
confirmed = barstate.isconfirmed and inDate
longEntry = confirmed and longSignal and strategy.position_size == 0
shortEntry = confirmed and shortSignal and strategy.position_size == 0

var float longStop = na
var float longTarget = na
var float shortStop = na
var float shortTarget = na

if longEntry
    risk = atr * stopATR
    longStop := close - risk
    longTarget := close + risk * rr
    strategy.entry("Long", strategy.long)
    strategy.exit("Long exit", "Long", stop=longStop, limit=longTarget)

if shortEntry
    risk = atr * stopATR
    shortStop := close + risk
    shortTarget := close - risk * rr
    strategy.entry("Short", strategy.short)
    strategy.exit("Short exit", "Short", stop=shortStop, limit=shortTarget)

if strategy.position_size > 0 and not na(longStop)
    strategy.exit("Long exit", "Long", stop=longStop, limit=longTarget)
if strategy.position_size < 0 and not na(shortStop)
    strategy.exit("Short exit", "Short", stop=shortStop, limit=shortTarget)

plot(st, "ATR Shift", color=direction < 0 ? color.lime : color.red, linewidth=2)
plotshape(longSignal and confirmed, title="Long signal", style=shape.triangleup,
     location=location.belowbar, color=color.lime, size=size.tiny, text="A+")
plotshape(shortSignal and confirmed, title="Short signal", style=shape.triangledown,
     location=location.abovebar, color=color.red, size=size.tiny, text="A-")
